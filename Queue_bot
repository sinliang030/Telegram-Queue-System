"""
Telegram Queue Bot  -  python-telegram-bot v22+
"""

import logging
from collections import deque
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

# ──────────────────────────────────────────────
# ✏️  EDIT THESE TWO LINES ONLY
# ──────────────────────────────────────────────
BOT_TOKEN = ""   # from @BotFather
ADMIN_IDS = {}            # your Telegram user ID
# ──────────────────────────────────────────────

logging.basicConfig(
    format="%(asctime)s | %(levelname)s | %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

queue: deque[dict] = deque()


def is_admin(user_id: int) -> bool:
    return user_id in ADMIN_IDS

def user_in_queue(user_id: int) -> bool:
    return any(e["id"] == user_id for e in queue)

def display_name(user) -> str:
    return (user.full_name or "").strip() or f"user_{user.id}"

def format_queue() -> str:
    if not queue:
        return "📭 The queue is currently empty."
    lines = [f"{i+1}. {e['name']} (id: {e['id']})" for i, e in enumerate(queue)]
    return "📋 *Current queue:*\n" + "\n".join(lines)


async def notify_positions(context) -> None:
    """Send each person in the queue their current position."""
    for i, entry in enumerate(queue):
        pos = i + 1
        try:
            if pos == 1:
                msg = "⚡ *You are now #1 in line!* Get ready, you're up next!"
            else:
                msg = f"🔔 Queue updated — your current position: *#{pos}*"
            await context.bot.send_message(
                chat_id=entry["id"],
                text=msg,
                parse_mode="Markdown",
            )
        except Exception as e:
            logger.warning("Could not notify %s: %s", entry["name"], e)


async def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text(
        "👋 Welcome to the *Queue Bot*!\n\n"
        "/join — add yourself to the queue\n"
        "/queue — see who's waiting\n"
        "/leave — remove yourself\n"
        "/help — all commands",
        parse_mode="Markdown",
    )

async def cmd_help(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    text = (
        "📖 *Queue Bot commands*\n\n"
        "/join — Add yourself to the queue\n"
        "/leave — Remove yourself from the queue\n"
        "/queue — Show the current queue\n"
    )
    if is_admin(update.effective_user.id):
        text += (
            "\n*Admin commands:*\n"
            "/next — Call & remove the first person\n"
            "/clear — Wipe the entire queue\n"
        )
    await update.message.reply_text(text, parse_mode="Markdown")

async def cmd_join(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    user = update.effective_user
    if user_in_queue(user.id):
        await update.message.reply_text("⚠️ You're already in the queue!")
        return
    name = display_name(user)
    queue.append({"id": user.id, "name": name})
    pos = len(queue)
    await update.message.reply_text(
        f"✅ *{name}*, you joined the queue!\nYour position: *#{pos}*",
        parse_mode="Markdown",
    )
    logger.info("JOINED  %s (%s) pos=%d", name, user.id, pos)

async def cmd_leave(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    user = update.effective_user
    if not user_in_queue(user.id):
        await update.message.reply_text("ℹ️ You're not in the queue.")
        return
    global queue
    queue = deque(e for e in queue if e["id"] != user.id)
    await update.message.reply_text("👋 You've been removed from the queue.")
    logger.info("LEFT    %s (%s)", display_name(user), user.id)
    # notify remaining people their position may have changed
    await notify_positions(context)

async def cmd_queue(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text(format_queue(), parse_mode="Markdown")

async def cmd_next(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not is_admin(update.effective_user.id):
        await update.message.reply_text("🚫 Admins only.")
        return
    if not queue:
        await update.message.reply_text("📭 The queue is already empty.")
        return

    served = queue.popleft()

    # notify the person who was called
    try:
        await context.bot.send_message(
            chat_id=served["id"],
            text="🎉 *It's your turn!* You've been called. Please proceed.",
            parse_mode="Markdown",
        )
    except Exception as e:
        logger.warning("Could not notify served user %s: %s", served["name"], e)

    await update.message.reply_text(
        f"✅ *{served['name']}* has been called and removed from the queue.\n"
        f"Remaining: *{len(queue)}*",
        parse_mode="Markdown",
    )
    logger.info("NEXT    served=%s remaining=%d", served["name"], len(queue))

    # notify everyone else their new position
    await notify_positions(context)

async def cmd_clear(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not is_admin(update.effective_user.id):
        await update.message.reply_text("🚫 Admins only.")
        return
    for entry in queue:
        try:
            await context.bot.send_message(
                chat_id=entry["id"],
                text="❌ The queue has been cleared by the admin. You have been removed.",
            )
        except Exception as e:
            logger.warning("Could not notify %s: %s", entry["name"], e)
    count = len(queue)
    queue.clear()
    await update.message.reply_text(
        f"🗑️ Queue cleared. *{count}* participant(s) removed.",
        parse_mode="Markdown",
    )
    logger.info("CLEARED %d entries", count)


def main() -> None:
    if BOT_TOKEN == "YOUR_BOT_TOKEN_HERE":
        raise ValueError("Please set your BOT_TOKEN on line 13 of queue_bot.py")

    app = ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help",  cmd_help))
    app.add_handler(CommandHandler("join",  cmd_join))
    app.add_handler(CommandHandler("leave", cmd_leave))
    app.add_handler(CommandHandler("queue", cmd_queue))
    app.add_handler(CommandHandler("next",  cmd_next))
    app.add_handler(CommandHandler("clear", cmd_clear))

    logger.info("Bot started — polling for updates…")
    app.run_polling()

if __name__ == "__main__":
    main()
